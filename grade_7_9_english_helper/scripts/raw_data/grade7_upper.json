[{"unitNumber":"Starter Unit 1","title":"Hello!","topic":"Greetings and self-introduction","words":[{"word":"hello","meaning":"你好"},{"word":"hi","meaning":"嗨；喂"},{"word":"good","meaning":"好的"},{"word":"morning","meaning":"早晨；上午"},{"word":"afternoon","meaning":"下午"},{"word":"evening","meaning":"晚上；傍晚"},{"word":"how","meaning":"如何；怎样"},{"word":"fine","meaning":"健康的；美好的"},{"word":"OK","meaning":"好；可以"},{"word":"what","meaning":"什么"},{"word":"is","meaning":"是"},{"word":"this","meaning":"这；这个"},{"word":"spell","meaning":"用字母拼；拼写"},{"word":"please","meaning":"请"},{"word":"greet","meaning":"招呼；问候"},{"word":"everyone","meaning":"每人；所有人"},{"word":"start","meaning":"开始；着手"},{"word":"conversation","meaning":"谈话；交谈"},{"word":"unit","meaning":"单元"},{"word":"section","meaning":"部分；地区"}],"grammar":["Be动词(am/is/are)的基本用法：I用am，you用are，he/she/it用is","26个英文字母的发音与书写规范；大写字母的使用场合"],"dialogueTheme":"日常问候（Good morning/afternoon/evening），自我介绍（I'm.../My name is...），询问姓名（What's your name?），问候与回应（How are you? — I'm fine, thank you.）"},{"unitNumber":"Starter Unit 2","title":"Keep Tidy!","topic":"School supplies, colors, and keeping things tidy","words":[{"word":"bottle","meaning":"瓶子"},{"word":"eraser","meaning":"橡皮"},{"word":"key","meaning":"钥匙；关键"},{"word":"thing","meaning":"东西；事情"},{"word":"need","meaning":"需要"},{"word":"tidy","meaning":"整洁的；井井有条的"},{"word":"schoolbag","meaning":"书包"},{"word":"cap","meaning":"帽子；棒球帽"},{"word":"ruler","meaning":"尺；直尺"},{"word":"pencil","meaning":"铅笔"},{"word":"red","meaning":"红色（的）"},{"word":"green","meaning":"绿色（的）"},{"word":"blue","meaning":"蓝色（的）"},{"word":"yellow","meaning":"黄色（的）"},{"word":"black","meaning":"黑色（的）"},{"word":"white","meaning":"白色（的）"},{"word":"orange","meaning":"橙色（的）"},{"word":"keep","meaning":"保持；保留"},{"word":"wake up","meaning":"醒来"},{"word":"get up","meaning":"起床"}],"grammar":["What do you have...? 句型及回答（I have a/an...）","表示颜色的形容词用法：What colour is it/are they? — It's/They're..."],"dialogueTheme":"谈论书包里的物品（What do you have in your scho